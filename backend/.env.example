# Copy to .env and adjust. Claude auth comes from the Claude Code login — no API key here.
# DATABASE_URL defaults to sqlite+aiosqlite:///<backend>/data/viberadio.db

# The dial — station names, styles, DJ personas and TTS voices — lives in
# viberadio/config.py (STATIONS), not here. New entries are created on next start.

# Seconds a station keeps running with no listeners before its agents shut down.
# STATION_IDLE_TIMEOUT_SEC=300

# How far ahead of the wall clock the renderer works. Raise on a slow machine.
# LOOKAHEAD_SEC=75

# Minimum songs the selector keeps queued ahead of the render cursor.
# MIN_QUEUED_SONGS=3
